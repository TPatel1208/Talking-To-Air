[run]
# The whole backend. This used to be a two-module slice (api, utils.db) left
# over from 00b5daa, so fail_under judged ~800 of ~12,000 statements and a
# regression anywhere else could not move it.
source =
    tta_backend

[report]
show_missing = True
skip_empty = True
# Measured 2026-09-30 at 89.5% with the CI Redis service up (86.9% without
# it: the turn-registry tests skip). Set below that for platform drift between
# the Windows measurement and CI's Linux run; raise it as coverage grows.
fail_under = 87
